// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RatingTargetType {
  field
  team
  player
}

// ...existing code...

model Team {
  id        Int      @id @default(autoincrement())
  name      String
  logoUrl   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Owner del equipo
  ownerId Int
  owner   User @relation("TeamOwner", fields: [ownerId], references: [id])

  // Relación con jugadores
  players PlayerTeam[]

  // Información deportiva
  lastGame         DateTime?
  preferredFieldId Int?
  preferredField   Field?    @relation("PreferredField", fields: [preferredFieldId], references: [id])
  isKotc           Boolean   @default(false)
  homeFieldId      Int?
  homeField        Field?    @relation("HomeField", fields: [homeFieldId], references: [id])

  // Métricas
  wins   Int @default(0)
  losses Int @default(0)
  draws  Int @default(0)
  points Int @default(0)

  // Info opcional pero muy útil
  description    String?
  colorPrimary   String?
  colorSecondary String?
  coverImageUrl  String?

  // Invitaciones enviadas
  invitations Invitation[]

  //Ubicacion
  region String?
  city   String?

  kings KingOfTheCourt[] @relation("TeamKing")

  gamesA Game[] @relation("GameTeamA")
  gamesB Game[] @relation("GameTeamB")
  gameStats GameStat[]
  teamStat TeamStat?
}

model PlayerTeam {
  id Int @id @default(autoincrement())

  userId   Int
  teamId   Int
  season   Int // Ej: 2024, 2025...
  joinedAt DateTime  @default(now())
  leftAt   DateTime?

  user User @relation(fields: [userId], references: [id])
  team Team @relation(fields: [teamId], references: [id])

  @@unique([userId, season]) // 1 jugador = 1 equipo por temporada
}

model Invitation {
  id       Int      @id @default(autoincrement())
  email    String
  teamId   Int
  sentAt   DateTime @default(now())
  accepted Boolean  @default(false)
  token    String   @unique

  team Team @relation(fields: [teamId], references: [id])
}

model Region {
  id      Int      @id @default(autoincrement())
  name    String   @unique
  latitude  Float?
  longitude Float?
  comunas Comuna[]
}

model Comuna {
  id       Int     @id @default(autoincrement())
  name     String
  latitude  Float?
  longitude Float?
  regionId Int
  region   Region  @relation(fields: [regionId], references: [id])
  fields   Field[]
}

model User {
  id        Int       @id @default(autoincrement())
  auth0Id   String    @unique
  email     String    @unique
  name      String?
  picture   String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  lastLogin DateTime?

  ownedTeams  Team[]       @relation("TeamOwner")
  playerTeams PlayerTeam[]
  ratings     Rating[]
  kings       KingOfTheCourt[] @relation("UserKing")

  gamesA Game[] @relation("GamePlayerA")
  gamesB Game[] @relation("GamePlayerB")
  gameStats GameStat[]
  playerStat PlayerStat?
}

model Field {
  id        Int      @id @default(autoincrement())
  name      String
  latitude  Float
  longitude Float
  photoUrl  String?
  comments  String[]
  comunaId  Int?
  comuna    Comuna?  @relation(fields: [comunaId], references: [id])
  isPaid    Boolean
  price     Float?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  teamsHome Team[] @relation("HomeField")
  teamsPref Team[] @relation("PreferredField")
  kings     KingOfTheCourt[]

  games Game[]
}

// Partido
model Game {
  id         Int      @id @default(autoincrement())
  date       DateTime @default(now())
  modality   String   // 1v1, 2v2, 3v3, 5v5
  fieldId    Int
  field      Field    @relation(fields: [fieldId], references: [id])
  teamAId    Int?
  teamA      Team?    @relation("GameTeamA", fields: [teamAId], references: [id])
  teamBId    Int?
  teamB      Team?    @relation("GameTeamB", fields: [teamBId], references: [id])
  playerAId  Int?
  playerA    User?    @relation("GamePlayerA", fields: [playerAId], references: [id])
  playerBId  Int?
  playerB    User?    @relation("GamePlayerB", fields: [playerBId], references: [id])
  scoreA     Int
  scoreB     Int
  stats      GameStat[]
}

// Estadísticas por partido
model GameStat {
  id       Int    @id @default(autoincrement())
  gameId   Int
  game     Game   @relation(fields: [gameId], references: [id])
  userId   Int?
  user     User?  @relation(fields: [userId], references: [id])
  teamId   Int?
  team     Team?  @relation(fields: [teamId], references: [id])
  points   Int    // Puntos anotados
  assists  Int    // Asistencias
  rebounds Int    // Rebotes
  steals   Int    // Robos
  blocks   Int    // Bloqueos
  fouls    Int    // Faltas
  minutes  Int    // Minutos jugados
}

// Estadísticas acumuladas por equipo
model TeamStat {
  id      Int   @id @default(autoincrement())
  teamId  Int   @unique
  team    Team  @relation(fields: [teamId], references: [id])
  pointsPerGame Float
  defensiveRating Float
  chemistry      Float
  globalRanking  Int
  rankingChange  Int
}

// Estadísticas acumuladas por usuario
model PlayerStat {
  id      Int   @id @default(autoincrement())
  userId  Int   @unique
  user    User  @relation(fields: [userId], references: [id])
  pointsPerGame Float
  defensiveRating Float
  globalRanking  Int
  rankingChange  Int
}

model Rating {
  id         Int      @id @default(autoincrement())
  value      Int // 1 a 5
  userId     Int
  user       User     @relation(fields: [userId], references: [id])
  targetType RatingTargetType
  targetId   Int // id del objeto valorado
  comment    String?
  createdAt  DateTime @default(now())
}

// King of the Court por modalidad y cancha
model KingOfTheCourt {
  id         Int      @id @default(autoincrement())
  fieldId    Int
  modality   String   // Ej: "5v5", "3v3", "2v2", "1v1"
  teamId     Int?     // Si es king por equipo
  userId     Int?     // Si es king individual
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  field      Field    @relation(fields: [fieldId], references: [id])
  team       Team?    @relation("TeamKing", fields: [teamId], references: [id])
  user       User?    @relation("UserKing", fields: [userId], references: [id])

  @@unique([fieldId, modality]) // Solo un king por modalidad/cancha
}

